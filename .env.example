# Aucun secret réel ici. Définir ces variables dans l'environnement du serveur.
DATABASE_URL=sqlite:///macite.db          # ou postgresql+psycopg://user:pass@host/macite
MACITE_ENV=production                    # production : l'API REFUSE de démarrer si MACITE_SECRET est absent, < 32 caractères ou une valeur d'exemple
MACITE_SECRET=                            # générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
MACITE_RELEVEUR_PASSWORD=
MACITE_EXPERT_PASSWORD=
MACITE_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
PHOTO_DIR=photos
MACITE_DOMAIN=
MACITE_CORS_ORIGINS=            # Origines web autorisées, séparées par des virgules ; ex. https://carte.exemple.bf

# --- Assistant IA (Google AI Studio). Désactivé par défaut. La clé reste SUR LE SERVEUR, jamais dans l'application web. ---
MACITE_AI_PROVIDER=off            # off | gemini
GEMINI_API_KEY=
GEMINI_MODEL=                     # modèle TEXTE acceptant generateContent (copier l'identifiant depuis AI Studio)
MACITE_AI_DAILY_PER_USER=20       # quota quotidien par utilisateur
MACITE_AI_DAILY_GLOBAL=400        # coupe-circuit global (offre gratuite : ~500 requêtes/jour/projet pour les modèles « Flash Lite »)

# --- Assistant VOCAL (Gemini Live), désactivé par défaut. L'audio va directement de l'appareil à Google ; le serveur ne fournit qu'un jeton à usage unique. ---
MACITE_AI_LIVE=off                # off | on
GEMINI_LIVE_MODEL=                # identifiant EXACT du modèle Live, copié depuis la documentation Google (préversion : il change)
# Quotas de la voix, SÉPARÉS de ceux du texte (une session vocale coûte bien plus qu'une requête texte).
MACITE_AI_LIVE_DAILY_PER_USER=5   # jetons vocaux par utilisateur et par jour (UTC)
MACITE_AI_LIVE_DAILY_GLOBAL=50    # coupe-circuit global de la voix
MACITE_AI_LIVE_COOLDOWN_S=10      # pause minimale entre deux jetons du même utilisateur (anti-rafale)
MACITE_AI_LIVE_MAX_SESSION_S=300  # durée maximale d'une session ; la durée de vie du jeton en est déduite (+ 60 s de démarrage + 30 s de marge)

# Recherche publique : nombre maximal de requêtes par minute et par client (429 au-delà)
MACITE_SEARCH_PER_MIN=60
# Identifiant du site servi par /sites/{site}/map et /offline-map
MACITE_SITE=kossodo

# Derrière Caddy : lire l'adresse du client dans X-Forwarded-For (verrou de connexion par adresse). Ne PAS activer sans proxy de confiance.
MACITE_TRUST_PROXY=1
# Échecs de connexion tolérés par adresse sur 5 min, tous identifiants confondus
MACITE_LOGIN_MAX_FAILS_PER_IP=30
# 1 = au démarrage, les mots de passe des comptes MACITE_<RÔLE>_PASSWORD écrasent ceux en base (défaut : non)
MACITE_SYNC_ENV_PASSWORDS=0
